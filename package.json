{
  "name": "harbormaster",
  "displayName": "Harbormaster",
  "icon": "resources/harbormaster.png",
  "description": "Project-aware window titles, accent colors, and AI context management.",
  "version": "3.2.0-alpha",
  "publisher": "harbormaster",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tiparium/VSCE_Harbormaster.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "harbormaster",
          "title": "Harbormaster",
          "icon": "resources/harbormaster.png"
        }
      ]
    },
    "views": {
      "harbormaster": [
        {
          "id": "harbormasterActions",
          "name": "Harbormaster",
          "contextualTitle": "Harbormaster",
          "icon": "resources/harbormaster.png",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "harbormaster.openCatalog",
        "title": "Harbormaster: Open project catalog",
        "category": "Harbormaster"
      },
      {
        "command": "harbormaster.createProject",
        "title": "Harbormaster: Create Harbormaster project",
        "category": "Harbormaster"
      },
      {
        "command": "harbormaster.openConfig",
        "title": "Harbormaster: Open project config",
        "category": "Harbormaster"
      },
      {
        "command": "harbormaster.rebuildState",
        "title": "Harbormaster: Rebuild project state",
        "category": "Harbormaster"
      },
      {
        "command": "harbormaster.setAccent",
        "title": "Harbormaster: Color settings",
        "category": "Harbormaster"
      },
      {
        "command": "harbormaster.clearAccent",
        "title": "Harbormaster: Clear color settings",
        "category": "Harbormaster"
      },
      {
        "command": "harbormaster.refresh",
        "title": "Harbormaster: Refresh",
        "category": "Harbormaster"
      },
      {
        "command": "harbormaster.runSetup",
        "title": "Harbormaster: Run setup",
        "category": "Harbormaster"
      },
      {
        "command": "harbormaster.manageAiTools",
        "title": "Harbormaster: Manage AI tools",
        "category": "Harbormaster"
      },
      {
        "command": "harbormaster.manageMcp",
        "title": "Harbormaster: Manage MCP registration",
        "category": "Harbormaster"
      },
      {
        "command": "harbormaster.reviewMigration",
        "title": "Harbormaster: Review current project migration",
        "category": "Harbormaster"
      }
    ],
    "configuration": {
      "title": "Harbormaster",
      "properties": {
        "harbormaster.projectCreateDefaultFolder": {
          "type": "string",
          "default": "",
          "description": "Default folder for the Create Project dialog (falls back to ~/Documents)."
        }
      }
    }
  },
  "scripts": {
    "postinstall": "patch-package",
    "vscode:prepublish": "npm run compile",
    "compile": "npm run typecheck && npm run typecheck:webview && npm run compile:ext && npm run compile:webview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:webview": "tsc -p tsconfig.webview.json --noEmit",
    "compile:ext": "node scripts/build-extension.js",
    "compile:webview": "node scripts/build-webview.js",
    "watch": "concurrently \"npm run watch:ext\" \"npm run watch:webview\"",
    "watch:ext": "node scripts/build-extension.js --watch",
    "watch:webview": "node scripts/build-webview.js --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "echo \"No lint configured\"",
    "migration:plan": "esbuild src/project/migrationCli.ts --bundle --platform=node --outfile=/tmp/harbormaster-migration-plan.js && node /tmp/harbormaster-migration-plan.js migration/live-projects.json migration/live-migration-plan.json",
    "migration:run": "esbuild src/project/migrationRunCli.ts --bundle --platform=node --outfile=/tmp/harbormaster-migration-run.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.85.0",
    "@vitest/coverage-v8": "^3.2.3",
    "concurrently": "^9.0.0",
    "esbuild": "^0.25.0",
    "patch-package": "^6.5.1",
    "typescript": "^5.4.0",
    "vitest": "^3.2.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "punycode": "^2.3.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "vsce": "^2.15.0"
  }
}
